# CampusConnect Mobile Environment Configuration
# ===============================================

# 1. Clerk Authentication Configuration
# Provide your Clerk Publishable Key (starts with pk_test_ or pk_live_)
# Note: NEVER put Clerk Secret Keys (sk_...) in mobile client applications.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_here

# 2. Campus Backend API Base URL (Section 03+)
EXPO_PUBLIC_API_URL=https://api.campusconnect.edu/v1

# 3. Environment identifier (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

